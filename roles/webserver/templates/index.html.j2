<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ webserver_title }}</title>
</head>
<body>
<h1>{{ webserver_title }}</h1>
<p>This page is managed by Ansible.</p>
<table border="1">
  <tr><th>Inventory host</th><td>{{ inventory_hostname }}</td></tr>
  <tr><th>Operating system</th><td>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</td></tr>
  <tr><th>Architecture</th><td>{{ ansible_facts['architecture'] }}</td></tr>
  <tr><th>Memory</th><td>{{ ansible_facts['memtotal_mb'] }} MB</td></tr>
  <tr><th>Environment</th><td>{{ deployment_environment }}</td></tr>
</table>
</body>
</html>
